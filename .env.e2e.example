# Copy to .env.e2e (gitignored) for end-to-end testing against Razorpay test mode.
# Run `pnpm e2e --dry-run` to check required names, then `pnpm e2e` with the maintainer.
# The runner uses these values only for the existing anonymous local Convex deployment.

# Dashboard → Account & Settings → API Keys, with the dashboard in Test Mode.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Dashboard → Webhooks (Test Mode) → the secret you set on the tunnel URL webhook.
RAZORPAY_WEBHOOK_SECRET=

# Optional: only for webhook secret rotation. Leave blank otherwise; the runner
# removes any stale previous secret from the local deployment when it is absent.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Never set RAZORPAY_TEST_MODE=true here. The runner deliberately uses the real
# Razorpay API with rzp_test_* credentials from this file.
